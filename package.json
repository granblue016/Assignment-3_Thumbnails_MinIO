		"@types/node": "^24",
		"eslint": "^4.0.0",
		"eslint-config-prettier": "^6.15.0",
		"eslint-plugin-svelte": "^1.1.2",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
